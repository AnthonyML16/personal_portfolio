---
import { Image } from "astro:assets";
import logo from "../images/isotipo_black.svg";
import Link from "./link-menu.astro";
import ButtonPrimary from "./button/primary.astro";
import Icon from "./icon.astro";

const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/projects", label: "Proyectos" },
  { href: "/experience", label: "Experiencia" },
  { href: "/skills", label: "Habilidades" },
  { href: "/contact", label: "Contacto" },
];
---

<nav class="fixed top-0 w-full z-50 p-4">
  <div
    class="max-w-7xl mx-auto flex items-center justify-between glass rounded-xl px-4 py-3 border border-teal-950/30 relative z-50"
  >
    <a href="/" class="flex items-center gap-2">
      <div
        class="size-8 bg-primary rounded flex items-center justify-center hover:brightness-110 transition-all duration-300"
      >
        <Image src={logo} alt="Logo Anthony" class="p-2" />
      </div>
      <h1
        class="relative inline-block text-lg font-bold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary bg-[length:0%_100%] bg-no-repeat hover:bg-[length:100%_100%] transition-[background-size] duration-700 ease-in-out"
      >
        <span
          class="text-white hover:text-transparent transition-colors duration-500"
        >
          Anthony
        </span>
      </h1>
    </a>

    <!-- Desktop Menu -->
    <div class="hidden md:flex items-center gap-8">
      {navItems.map((item) => <Link href={item.href} label={item.label} />)}
    </div>

    <!-- Desktop Contact Button -->
    <a href="/contact" class="hidden md:block">
      <ButtonPrimary class="px-5! py-2! rounded-full!">
        Contáctame
      </ButtonPrimary>
    </a>

    <!-- Mobile Hamburger Button -->
    <button
      id="menu-toggle"
      class="md:hidden text-white focus:outline-none"
      aria-label="Toggle menu"
    >
      <Icon icon="menu" class="3xl" />
    </button>
  </div>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-neutral-950/90 backdrop-blur-md z-40 flex flex-col items-center justify-center gap-8 transition-transform duration-300 translate-x-full md:hidden"
  >
    <!-- Close Button -->
    <button
      id="menu-close"
      class="absolute top-6 right-6 text-white focus:outline-none"
      aria-label="Close menu"
    >
      <Icon icon="close" class="4xl" />
    </button>

    <!-- Mobile Links -->
    <div class="flex flex-col items-center gap-6">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-2xl text-white/80 font-medium hover:text-primary transition-colors mobile-link"
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <!-- Mobile Contact Button -->
    <a href="/contact" class="mobile-link mt-4">
      <ButtonPrimary class="px-8! py-3! rounded-full! text-lg!">
        Contáctame
      </ButtonPrimary>
    </a>
  </div>
</nav>

<script>
  function initNavigation() {
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuClose = document.getElementById("menu-close");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    if (!menuToggle || !mobileMenu) return;

    function toggleMenu() {
      mobileMenu?.classList.toggle("translate-x-full");
      document.body.classList.toggle("overflow-hidden");
    }

    menuToggle.onclick = toggleMenu;
    if (menuClose) menuClose.onclick = toggleMenu;

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("translate-x-full");
        document.body.classList.remove("overflow-hidden");
      });
    });
  }

  initNavigation();

  document.addEventListener("astro:page-load", initNavigation);
</script>
