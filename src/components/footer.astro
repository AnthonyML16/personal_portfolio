---
const { year = new Date().getFullYear() } = Astro.props;
---

<footer
  class="max-w-7xl mx-auto px-6 py-12 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-6"
>
  <p class="text-slate-500 text-sm text-center text-balance">
    © {year} Anthony Meza Lopez. Todos los derechos reservados
  </p>
  <div class="flex items-center gap-4">
    <p class="text-xs text-slate-500">Abierto a nuevas oportunidades</p>
    <div class="size-2 rounded-full bg-primary animate-pulse"></div>
  </div>
</footer>
