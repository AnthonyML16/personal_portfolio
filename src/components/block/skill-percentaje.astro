---
interface Props {
  skill: string;
  percentage: number;
}

const { skill, percentage } = Astro.props;
---

<div>
  <div class="flex justify-between text-sm mb-2">
    <span class="font-bold">{skill}</span>
    <span class="text-primary">{percentage}%</span>
  </div>
  <div
    class="h-2 bg-white/5 rounded-full overflow-hidden border border-white/10"
  >
    <div
      class="h-full bg-primary shadow-[0_0_10px_rgba(34,211,238,0.5)]"
      style={`width: ${percentage}%`}
    >
    </div>
  </div>
</div>
