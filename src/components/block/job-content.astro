---
interface Props {
  title: string;
  date: string;
  company: string;
  description: string[];
}

const { title, description, date, company } = Astro.props;
---

<div class="relative pl-10">
  <div
    class="absolute left-0 top-1.5 size-3 rounded-full bg-primary shadow-[0_0_10px_rgba(13,242,242,0.8)]"
  >
  </div>
  <div
    class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-2"
  >
    <h4 class="text-xl font-bold text-white">{title}</h4>
    <span
      class="w-fit text-xs font-bold px-3 py-1 rounded-full bg-white/5 border border-white/10 text-slate-400"
    >
      {date}
    </span>
  </div>
  <p class="text-primary font-medium text-sm mb-4">{company}</p>
  <ul class="space-y-3 text-slate-400 text-sm leading-relaxed">
    {
      description.map((item) => (
        <li class="flex gap-2">
          <span class="text-primary">•</span>
          {item}
        </li>
      ))
    }
  </ul>
</div>
