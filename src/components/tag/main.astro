---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"span"> {
  label: string;
}

const { class: className, label, ...props } = Astro.props;
---

<span
  class="px-3 py-1 bg-primary/10 text-primary text-[10px] font-bold uppercase rounded-full"
  {...props}
>
  {label}
</span>
