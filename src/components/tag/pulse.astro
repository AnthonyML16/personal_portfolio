---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div
  class="flex items-center gap-2 bg-primary/10 border border-primary/20 px-3 py-1 rounded-full w-fit"
>
  <span class="size-2 bg-primary rounded-full animate-pulse"></span>
  <span class="text-primary text-xs font-bold uppercase tracking-wider"
    >{label}</span
  >
</div>
