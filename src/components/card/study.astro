---
import Card from "./main.astro";
import Icon from "../icon.astro";

interface Props {
  icon: string;
  title: string;
  institution: string;
  status: string;
  date: string;
  description: string;
}

const { icon, title, institution, status, date, description } = Astro.props;
---

<Card class="flex flex-col justify-between h-full group">
  <div>
    <div
      class="size-10 bg-primary/10 rounded-lg flex items-center justify-center border border-primary/20 mb-4 group-hover:bg-primary/20 transition-colors duration-300"
    >
      <Icon icon={icon} />
    </div>
    <h4 class="text-lg font-bold text-white mb-1">{title}</h4>
    <p class="text-slate-400 text-sm">{institution}</p>
    <p class="text-slate-300 text-sm mt-2">{description}</p>
  </div>
  <div
    class="mt-8 pt-4 border-t border-white/5 flex justify-between items-center"
  >
    <span class="text-[10px] font-bold text-primary uppercase tracking-widest">
      {status}
    </span>
    <span class="text-xs text-slate-500 italic">{date}</span>
  </div>
</Card>
