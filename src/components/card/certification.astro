---
import Card from "./main.astro";
const { title, tech, date, institution } = Astro.props;
---

<Card class="p-5">
  <span
    class="text-[10px] font-bold text-primary uppercase tracking-widest block mb-2"
  >
    {tech}
  </span>
  <h5 class="font-bold text-white text-sm mb-1">
    {title}
  </h5>
  <p class="text-slate-500 text-xs">
    {date} - {institution}
  </p>
</Card>
