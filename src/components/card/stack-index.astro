---
import Icon from "../icon.astro";

interface Props {
  icon: string;
  label: string;
}

const { icon, label } = Astro.props;
---

<div
  class="flex flex-col gap-2 p-4 bg-white/5 rounded-xl border border-white/10"
>
  <Icon icon={icon} />
  <span class="text-white font-bold">{label}</span>
</div>
