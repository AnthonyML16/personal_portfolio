---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  label: string;
}

const { class: className, label, ...props } = Astro.props;
---

<a
  class:list={[
    "bg-primary text-neutral-950 px-6 py-3 rounded-xl text-sm font-bold hover:brightness-80 transition-all duration-300",
    className,
  ]}
  {...props}
>
  {label}
</a>
