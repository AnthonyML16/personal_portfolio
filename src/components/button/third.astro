---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {}

const { class: className, ...props } = Astro.props;
---

<button
  class:list={[
    "border border-white/10 text-white px-6 py-3 rounded-xl text-sm font-bold hover:bg-white/5 transition-all duration-300 cursor-pointer flex items-center justify-center gap-4",
    className,
  ]}
  {...props}
>
  <slot />
</button>
