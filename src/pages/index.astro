---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Card from "../components/card/main.astro";
import SubCard from "../components/card/stack-index.astro";
import Icon from "../components/icon.astro";
import TagPulse from "../components/tag/pulse.astro";
import TagMain from "../components/tag/main.astro";
import ButtonPrimary from "../components/button/primary.astro";
import ButtonSecond from "../components/button/second.astro";
import ButtonThird from "../components/button/third.astro";
import { getCollection } from "astro:content";

import ImageProfile from "../images/profile.webp";

import { getGitHubMetrics } from "../services/github";

const USERNAME = "AnthonyML16";
const { total, columns } = await getGitHubMetrics(USERNAME);
const projects = await getCollection("projects");

const getColorClass = (count: number) => {
  if (count === 0) return "bg-primary/10";
  if (count < 3) return "bg-primary/30";
  if (count < 6) return "bg-primary/60";
  return "bg-primary/90";
};

const sortProject = projects.sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

const project = sortProject[0];
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/projects/*.webp",
);
const imagePath = `/src/images/projects/${project.data.img}`;

if (!images[imagePath])
  throw new Error(`"${imagePath}" no existe en "src/images/projects/"`);

export const prerender = true;
---

<Layout>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
    <!-- Hero Tile -->
    <Card
      class="md:col-span-8 md:row-span-2 p-8 relative overflow-hidden flex flex-col justify-end min-h-[450px] md:min-h-[400px]"
    >
      <div class="absolute inset-0 cyan-radial pointer-events-none"></div>
      <div class="absolute top-6 left-6 md:top-8 md:right-8">
        <TagPulse label="Disponible para proyectos" />
      </div>
      <div
        class="relative z-10 flex flex-col md:flex-row gap-6 md:gap-8 items-start md:items-center"
      >
        <div
          class="size-32 md:size-40 rounded-2xl bg-cover bg-center border-2 border-primary/20 overflow-hidden shadow-2xl shadow-primary/10"
        >
          <Image
            src={ImageProfile}
            alt="Anthony Meza profile picture"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="text-left">
          <p class="text-primary font-medium mb-1 md:mb-2">Hola, Soy</p>
          <h2
            class="text-4xl md:text-6xl font-extrabold text-white tracking-tighter mb-3 md:mb-4"
          >
            Anthony
          </h2>
          <p
            class="text-slate-400 text-base md:text-lg max-w-md leading-relaxed"
          >
            Full Stack Developer de 22 años dedicado a crear experiencias
            digitales especializadas.
          </p>
        </div>
      </div>
    </Card>

    <!-- Tech Stack -->
    <Card class="md:col-span-4 flex flex-col justify-between">
      <h3
        class="text-white/60 text-sm font-semibold uppercase tracking-widest mb-6"
      >
        Stack Tecnológico
      </h3>
      <div class="grid grid-cols-2 gap-4">
        <SubCard icon="terminal" label="PHP" />
        <SubCard icon="terminal" label="Laravel" />
        <SubCard icon="database" label="MySQL" />
        <SubCard icon="swatch" label="Tailwind" />
      </div>
    </Card>

    <!-- GitHub Activity -->
    <Card class="md:col-span-4 relative">
      <div class="flex justify-between items-start mb-4">
        <div>
          <h3
            class="text-white/60 text-sm font-semibold uppercase tracking-widest mb-1"
          >
            GitHub Activity
          </h3>
          <p class="text-2xl font-bold text-white tracking-tight">
            {total.toLocaleString()}+ Commits
          </p>
        </div>
        <Icon icon="chart-trend" />
      </div>

      <div class="flex flex-col gap-1">
        <div class="flex gap-1 overflow-visible">
          {
            columns.map((col) => (
              <div class="flex flex-col gap-1">
                {col.map((day) => (
                  <div class="relative group/day">
                    {" "}
                    <div
                      class={`size-3 rounded-sm transition-all duration-300 ${getColorClass(day.contributionCount)} group-hover/day:ring-1 group-hover/day:ring-white/50`}
                    />
                    <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/day:block z-50">
                      <div class="bg-slate-900/95 backdrop-blur-md text-white text-[10px] py-1 px-2 rounded border border-white/10 whitespace-nowrap shadow-xl">
                        <span class="font-bold text-primary">
                          {day.contributionCount} commits
                        </span>
                        <span class="text-white/60 ml-1">
                          {day.formattedDate}
                        </span>
                      </div>
                      <div class="w-2 h-2 bg-slate-900 border-r border-b border-white/10 rotate-45 absolute -bottom-1 left-1/2 -translate-x-1/2" />
                    </div>
                  </div>
                ))}
              </div>
            ))
          }
        </div>
        <p class="text-xs text-slate-500 mt-2">
          Participación activa diaria en proyectos
        </p>
      </div>
    </Card>

    <!-- Featured Project Tile (Wide) -->
    <Card class="md:col-span-9 overflow-hidden group p-0!">
      <div class="grid md:grid-cols-2 h-full">
        <div class="p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-4">
              <TagMain label="Último proyecto" />
              <span class="text-white/40 text-xs font-medium text-center">
                {project.data.type}
              </span>
            </div>
            <h3 class="text-3xl font-bold text-white mb-4">
              {project.data.title}
            </h3>
            <p class="text-slate-400 mb-6">
              {project.data.description}
            </p>
          </div>
          <div class="flex gap-4">
            {
              project.data.site && (
                <a href={project.data.site} target="_blank">
                  <ButtonPrimary class="group/btn">
                    Visitar sitio
                    <Icon
                      icon="arrow-right-stroke"
                      class="text-neutral-950! group-hover/btn:translate-x-1 transition-transform"
                    />
                  </ButtonPrimary>
                </a>
              )
            }
            {
              project.data.repo && (
                <a href={project.data.repo} target="_blank">
                  <ButtonThird class="group/btn">
                    Visitar Repositorio
                  </ButtonThird>
                </a>
              )
            }
          </div>
        </div>
        <div class="min-h-[300px] border-l border-white/10 relative">
          <Image
            src={images[imagePath]()}
            alt={`Image of ${project.data.title}`}
            class="w-full h-full object-cover absolute inset-0 opacity-50"
          />
          <div
            class="absolute inset-0 bg-gradient-to-b md:bg-gradient-to-r from-neutral-950/80 via-transparent to-transparent"
          >
          </div>
        </div>
      </div>
    </Card>

    <!-- Contact/Social Tile -->
    <Card class="md:col-span-3 flex flex-col justify-between">
      <div>
        <h3
          class="text-white/60 text-sm font-semibold uppercase tracking-widest mb-6"
        >
          Conectémonos
        </h3>
        <div class="space-y-4">
          <a
            class="flex items-center gap-4 text-white hover:text-primary transition-colors group"
            href="mailto:luis.anthony.laml@gmail.com"
            target="_blank"
          >
            <ButtonSecond
              class="p-3! text-current! group-hover:border-primary/50"
            >
              <Icon icon="gmail" color="current" size="xs" pack="bxl" />
            </ButtonSecond>
            <span class="font-medium">Correo</span>
          </a>
          <a
            class="flex items-center gap-4 text-white hover:text-primary transition-colors group"
            href="https://www.linkedin.com/in/anthony-meza-106385213/"
            target="_blank"
          >
            <ButtonSecond
              class="p-3! text-current! group-hover:border-primary/50"
            >
              <Icon icon="linkedin" color="current" size="xs" pack="bxl" />
            </ButtonSecond>
            <span class="font-medium">LinkedIn</span>
          </a>
          <a
            class="flex items-center gap-4 text-white hover:text-primary transition-colors group"
            href="https://github.com/AnthonyML16"
            target="_blank"
          >
            <ButtonSecond
              class="p-3! text-current! group-hover:border-primary/50"
            >
              <Icon icon="github" color="current" size="xs" pack="bxl" />
            </ButtonSecond>
            <span class="font-medium">GitHub</span>
          </a>
        </div>
      </div>
      <div class="mt-8 pt-6 border-t border-white/10">
        <p class="text-slate-500 text-xs">Ubicado en Lima, Perú</p>
        <p class="text-white text-sm font-semibold mt-1">
          Disponible para trabajo remoto
        </p>
      </div>
    </Card>
  </div>
  <!-- Decorative background elements -->
  <div
    class="fixed top-1/4 -left-20 size-[500px] bg-j/5 blur-[120px] rounded-full -z-10"
  >
  </div>
  <div
    class="fixed bottom-1/4 -right-20 size-[400px] bg-primary/10 blur-[100px] rounded-full -z-10"
  >
  </div>
</Layout>
