---
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import Layout from "../layouts/Layout.astro";
import TitlePage from "../components/title/page.astro";
import Card from "../components/card/project.astro";

const posts = await getCollection("posts");

const sortPost = posts.sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

const featuredPost = sortPost[0];
const remainingPosts = sortPost.slice(1);

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/posts/*.webp",
);

export const prerender = true;
---

<Layout title="Blog | Anthony's Portfolio">
  <TitlePage
    pulse="Publicaciones"
    title="Engineering"
    colorTitle="Insights"
    description="Deep dives into modern web architecture, UI/UX patterns, and the future of frontend engineering."
  />

  <!-- Bento Grid Layout -->
  <div class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-3 gap-6">
    <!-- Featured Post (Large Tile) -->
    {
      featuredPost && (
        <div class="md:col-span-3 md:row-span-2 glass bento-card rounded-xl overflow-hidden flex flex-col group relative">
          <div class="relative h-64 md:h-full overflow-hidden">
            <div class="absolute inset-0 z-0">
              <Image
                src={images[`/src/images/posts/${featuredPost.data.img}`]()}
                alt={featuredPost.data.title}
                class="w-full h-full object-cover opacity-50 transition-transform duration-500 group-hover:scale-105 group-hover:opacity-75"
              />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/40 to-transparent z-10" />

            <div class="absolute top-6 left-6 z-20">
              <span class="bg-cyan-400/20 text-cyan-400 border border-cyan-400/30 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest backdrop-blur-md">
                Último Post
              </span>
            </div>

            <div class="absolute bottom-0 left-0 p-8 w-full z-20">
              <div class="flex items-center gap-4 mb-3 text-slate-300 text-sm">
                <span class="flex items-center gap-1">
                  <span class="material-symbols-outlined text-sm">
                    schedule
                  </span>
                  {featuredPost.data.readTime || "10 min"} read
                </span>
                <span class="flex items-center gap-1">
                  <span class="material-symbols-outlined text-sm">
                    calendar_today
                  </span>
                  {new Date(featuredPost.data.date).toLocaleDateString(
                    "es-ES",
                    { day: "2-digit", month: "short", year: "numeric" },
                  )}
                </span>
              </div>
              <h3 class="text-3xl md:text-4xl font-extrabold text-white mb-4 group-hover:text-cyan-400 transition-colors">
                {featuredPost.data.title}
              </h3>
              <p class="text-slate-300 text-lg mb-6 line-clamp-2 max-w-3xl">
                {featuredPost.data.description}
              </p>
              <a
                href={`/post/${featuredPost.slug}`}
                class="inline-flex items-center gap-2 bg-cyan-400 text-neutral-950 px-6 py-3 rounded-lg font-bold hover:scale-105 transition-transform"
              >
                Leer Artículo Completo
                <span class="material-symbols-outlined">arrow_forward</span>
              </a>
            </div>
          </div>
        </div>
      )
    }

    <!-- Categories (Side Tile) -->
    <div
      class="md:col-span-1 md:row-span-1 glass bento-card rounded-xl p-6 flex flex-col"
    >
      <div class="flex items-center gap-2 mb-6">
        <span class="material-symbols-outlined text-cyan-400">category</span>
        <h3 class="font-bold text-lg">Temas</h3>
      </div>
      <div class="flex flex-wrap gap-2">
        {
          ["React", "TypeScript", "PHP", "Laravel", "Next.js", "Node.js"].map(
            (topic) => (
              <span class="bg-white/5 border border-white/10 px-3 py-1.5 rounded-lg text-xs text-slate-300 cursor-default">
                {topic}
              </span>
            ),
          )
        }
      </div>
    </div>

    <div
      class="md:col-span-1 md:row-span-1 glass bento-card rounded-xl p-6 bg-cyan-400/5 flex flex-col justify-between border-cyan-400/20"
    >
      <h3 class="font-bold text-lg mb-2 leading-tight text-white">
        Newsletter Semanal
      </h3>
      <div class="space-y-3">
        <input
          class="w-full bg-neutral-950 border-white/10 rounded-lg px-4 py-2 text-sm text-white outline-none focus:border-cyan-400"
          placeholder="tu@email.com"
          type="email"
        />
        <button
          class="w-full bg-cyan-400 text-neutral-950 py-2 rounded-lg text-sm font-bold"
          >Suscribirme</button
        >
      </div>
    </div>

    {
      remainingPosts.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="glass bento-card rounded-xl overflow-hidden group flex flex-col"
        >
          <div class="h-40 overflow-hidden relative">
            <Image
              src={images[`/src/images/posts/${post.data.img}`]()}
              alt={post.data.title}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110 opacity-70 group-hover:opacity-100"
            />
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <div class="text-[10px] text-cyan-400 mb-2 uppercase tracking-widest font-bold">
                {post.data.category || "Engineering"} •{" "}
                {post.data.readTime || "5 min"}
              </div>
              <h4 class="font-bold text-white group-hover:text-cyan-400 transition-colors mb-2 line-clamp-2">
                {post.data.title}
              </h4>
              <p class="text-xs text-slate-400 line-clamp-2">
                {post.data.description}
              </p>
            </div>
          </div>
        </a>
      ))
    }

    <div
      class="glass bento-card rounded-xl p-5 flex flex-col justify-center text-center"
    >
      <div class="grid grid-cols-2 gap-4">
        <div
          class="p-3 bg-white/5 rounded-lg border border-white/5 text-center"
        >
          <div class="text-2xl font-black text-cyan-400">{posts.length}</div>
          <div class="text-[10px] text-slate-500 uppercase tracking-widest">
            Artículos
          </div>
        </div>
        <div
          class="p-3 bg-white/5 rounded-lg border border-white/5 text-center"
        >
          <div class="text-2xl font-black text-cyan-400">12k</div>
          <div class="text-[10px] text-slate-500 uppercase tracking-widest">
            Lectores
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
