---
import Layout from "../layouts/Layout.astro";

const posts = [
  {
    title: "Getting Started with Astro 5.0",
    date: "February 1, 2026",
    excerpt:
      "Why Astro is becoming my go-to framework for content-heavy websites and how you can get started.",
    readTime: "5 min read",
  },
  {
    title: "The Future of Web Styling",
    date: "January 15, 2026",
    excerpt:
      "Exploring the new features in Tailwind CSS v4 and how they improvde developer experience.",
    readTime: "4 min read",
  },
  {
    title: "Building Accessible Components",
    date: "December 20, 2025",
    excerpt:
      "A guide to creating inclusive web applications ensuring everyone can use your software.",
    readTime: "7 min read",
  },
];
---

<Layout title="Blog | Anthony's Portfolio">
  <div class="mb-12">
    <h2 class="text-5xl font-black tracking-tight mb-4">
      Engineering <span class="text-cyan-400 italic">Insights</span>
    </h2>
    <p class="text-slate-400 max-w-2xl text-lg">
      Deep dives into modern web architecture, UI/UX patterns, and the future of
      frontend engineering.
    </p>
  </div>
  <!-- Bento Grid Layout -->
  <div class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-3 gap-6">
    <!-- Featured Post (Large Tile) -->
    <div
      class="md:col-span-3 md:row-span-2 glass bento-card rounded-xl overflow-hidden flex flex-col group"
    >
      <div class="relative h-64 md:h-full overflow-hidden">
        <div
          class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105"
          data-alt="Abstract 3D rendering of neon geometric shapes"
          style='
                background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAtCYUH5hb97S8spGGnWyeyOpMvCLleD_vKu8ElE3pdj2q0tpPwp2dCW8HOi0jwNrFOJLkCrMsnecYSvE2_xca9CBJQ0KsNQMNpPKJqyCRxQt5qY_x1vdFbiR1WOQ-KiUoLFfHZOVJVkwOVp_lVtkiRLL-k2SvsQEEYcFtWckrkb49R2oswxC__KPBnRR6zQdKYbG272tqWT9frGhZyzRb5baz4BlijlMi9R7LqceRqVolhs9wkqACSf-B3cnp4PpbvIopXvYIdmu4");
              '
        >
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/40 to-transparent"
        >
        </div>
        <div class="absolute top-6 left-6">
          <span
            class="bg-cyan-400/20 text-cyan-400 border border-cyan-400/30 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest backdrop-blur-md"
            >Featured Post</span
          >
        </div>
        <div class="absolute bottom-0 left-0 p-8 w-full">
          <div class="flex items-center gap-4 mb-3 text-slate-300 text-sm">
            <span class="flex items-center gap-1"
              ><span class="material-symbols-outlined text-sm">schedule</span>
              12 min read</span
            >
            <span class="flex items-center gap-1"
              ><span class="material-symbols-outlined text-sm"
                >calendar_today</span
              >
              Dec 18, 2023</span
            >
          </div>
          <h3
            class="text-3xl md:text-4xl font-extrabold text-white mb-4 group-hover:text-cyan-400 transition-colors"
          >
            Mastering React Server Components: A New Era of Performance
          </h3>
          <p class="text-slate-300 text-lg mb-6 line-clamp-2 max-w-3xl">
            Understanding the paradigm shift in how we build and deliver modern
            React applications to the edge.
          </p>
          <button
            class="flex items-center gap-2 bg-cyan-400 text-neutral-950 px-6 py-3 rounded-lg font-bold hover:scale-105 transition-transform"
          >
            Read Full Article
            <span class="material-symbols-outlined">arrow_forward</span>
          </button>
        </div>
      </div>
    </div>
    <!-- Categories (Side Tile) -->
    <div
      class="md:col-span-1 md:row-span-1 glass bento-card rounded-xl p-6 flex flex-col"
    >
      <div class="flex items-center gap-2 mb-6">
        <span class="material-symbols-outlined text-cyan-400">category</span>
        <h3 class="font-bold text-lg">Topics</h3>
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          class="bg-white/5 hover:bg-cyan-400/20 hover:text-cyan-400 border border-white/10 px-3 py-1.5 rounded-lg text-sm transition-all flex items-center gap-2"
          href="#"
        >
          <span class="material-symbols-outlined text-xs">atm</span> React
        </a>
        <a
          class="bg-white/5 hover:bg-cyan-400/20 hover:text-cyan-400 border border-white/10 px-3 py-1.5 rounded-lg text-sm transition-all flex items-center gap-2"
          href="#"
        >
          <span class="material-symbols-outlined text-xs">code</span>
          TypeScript
        </a>
        <a
          class="bg-white/5 hover:bg-cyan-400/20 hover:text-cyan-400 border border-white/10 px-3 py-1.5 rounded-lg text-sm transition-all flex items-center gap-2"
          href="#"
        >
          <span class="material-symbols-outlined text-xs">palette</span>
          UI/UX
        </a>
        <a
          class="bg-white/5 hover:bg-cyan-400/20 hover:text-cyan-400 border border-white/10 px-3 py-1.5 rounded-lg text-sm transition-all flex items-center gap-2"
          href="#"
        >
          <span class="material-symbols-outlined text-xs">settings</span>
          Rust
        </a>
        <a
          class="bg-white/5 hover:bg-cyan-400/20 hover:text-cyan-400 border border-white/10 px-3 py-1.5 rounded-lg text-sm transition-all flex items-center gap-2"
          href="#"
        >
          <span class="material-symbols-outlined text-xs">bolt</span>
          Next.js
        </a>
        <a
          class="bg-white/5 hover:bg-cyan-400/20 hover:text-cyan-400 border border-white/10 px-3 py-1.5 rounded-lg text-sm transition-all flex items-center gap-2"
          href="#"
        >
          <span class="material-symbols-outlined text-xs">terminal</span>
          Node.js
        </a>
      </div>
    </div>
    <!-- Newsletter (Side Tile) -->
    <div
      class="md:col-span-1 md:row-span-1 glass bento-card rounded-xl p-6 bg-cyan-400/5 flex flex-col justify-between border-cyan-400/20"
    >
      <div>
        <h3 class="font-bold text-lg mb-2">Weekly Briefing</h3>
        <p class="text-sm text-slate-400 mb-4">
          Get curated frontend resources and articles delivered to your inbox.
        </p>
      </div>
      <div class="space-y-3">
        <input
          class="w-full bg-neutral-950 border-white/10 rounded-lg px-4 py-2 text-sm focus:ring-1 focus:ring-cyan-400 focus:border-cyan-400"
          placeholder="your@email.com"
          type="email"
        />
        <button
          class="w-full bg-cyan-400 text-neutral-950 py-2 rounded-lg text-sm font-bold"
        >
          Subscribe
        </button>
      </div>
    </div>
    <!-- Recent Post 1 -->
    <div class="glass bento-card rounded-xl overflow-hidden group">
      <div
        class="h-40 bg-cover bg-center"
        data-alt="Close up of high-quality code on a dark screen"
        style='
