---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import TitlePage from "../components/title/page.astro";
import Icon from "../components/icon.astro";
import ImageMap from "../images/map.webp";
---

<Layout title="Contact | Anthony's Portfolio">
  <TitlePage
    pulse="Conectémonos"
    title="Contacto"
    description="¿Tienes un proyecto en mente o buscas fortalecer tu equipo? Estoy disponible para colaboraciones estratégicas y desarrollo de software de alto impacto."
  />

  <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
    <div
      class="md:col-span-7 lg:col-span-8 relative overflow-hidden bg-[#1c2627] rounded-xl border border-[#3b5254] p-8 shadow-sm h-full group"
    >
      <div
        class="absolute inset-0 opacity-20 grayscale group-hover:grayscale-0 transition-all duration-500 bg-cover bg-center"
      >
        <Image src={ImageMap} alt="Map" class="w-full h-full object-cover" />
      </div>
      <div class="relative z-10 h-full flex flex-col justify-end">
        <div
          class="size-12 rounded-lg bg-primary/20 flex items-center justify-center text-primary mb-4"
        >
          <Icon icon="location" />
        </div>
        <h3 class="text-white text-2xl font-bold">Ubicado en Lima, Perú</h3>
        <p class="text-slate-400 text-base">
          Disponible para trabajo remoto y colaboraciones con equipos
          internacionales.
        </p>
      </div>
    </div>

    <div class="md:col-span-5 lg:col-span-4 flex flex-col gap-6">
      <div class="grid grid-cols-2 gap-4">
        <a
          class="flex items-center justify-center p-6 bg-[#0077b5]/20 border border-[#0077b5]/30 rounded-xl hover:bg-[#0077b5]/30 transition-all duration-300 group"
          href="https://www.linkedin.com/in/anthony-meza-106385213/"
          target="_blank"
        >
          <span
            class="flex items-center gap-2 text-[#0077b5] font-bold text-sm mb-1 group-hover:scale-110 transition-transform duration-300"
          >
            <Icon icon="linkedin" color="current" size="sm" pack="bxl" />
            LinkedIn
          </span>
        </a>

        <a
          class="flex items-center justify-center p-6 bg-white/5 border border-white/10 rounded-xl hover:bg-white/10 transition-all group"
          href="https://github.com/AnthonyML16"
          target="_blank"
        >
          <span
            class="flex items-center gap-2 text-white font-bold text-sm mb-1 group-hover:scale-110 transition-transform"
          >
            <Icon icon="github" color="current" size="sm" pack="bxl" />
            GitHub
          </span>
        </a>
      </div>

      <div
        class="bg-[#1c2627] rounded-xl border border-[#3b5254] p-6 shadow-sm flex items-center gap-4"
      >
        <div
          class="size-12 rounded-full bg-[#111718] flex items-center justify-center text-primary"
        >
          <Icon icon="at" color="current" size="sm" />
        </div>
        <div>
          <p class="text-xs text-slate-400 font-bold uppercase tracking-wider">
            Correo directo
          </p>
          <a
            class="text-white font-semibold hover:text-primary transition-colors"
            href="mailto:luis.anthony.laml@gmail.com"
            target="_blank"
          >
            luis.anthony.laml@gmail.com
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
