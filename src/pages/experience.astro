---
import Layout from "../layouts/Layout.astro";
import TitlePage from "../components/title/page.astro";
import Card from "../components/card/main.astro";
import TitleCard from "../components/title/card.astro";
import Icon from "../components/icon.astro";
import JobContent from "../components/block/job-content.astro";
import StudyContent from "../components/card/study.astro";
import Certification from "../components/card/certification.astro";
import { getCollection } from "astro:content";
import { formatShortDate } from "../utils/formatDate";
import Technical from "../components/card/technical.astro";

const jobs = await getCollection("jobs");
const certifications = await getCollection("certifications");
const skills = await getCollection("skills");

const sortedJobs = jobs.sort((a, b) => {
  return (
    new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime()
  );
});

const sortedCertifications = certifications.sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

export const prerender = true;
---

<Layout title="Experience | Anthony's Portfolio">
  <TitlePage
    pulse="Trayectoria"
    title="Experiencia"
    colorTitle="Profesional"
    description="Mi recorrido profesional colaborando con empresas para digitalizar procesos y optimizar la gestión de datos a través de software a medida."
  />

  <div class="grid grid-cols-12 gap-6">
    <Card class="col-span-12 lg:col-span-8 p-8">
      <TitleCard icon="briefcase-alt" title="Laboral" />
      <div class="relative">
        <div class="absolute left-1.5 top-2 bottom-2 w-0.5 timeline-line"></div>
        <div class="space-y-12">
          {
            sortedJobs.length > 0 ? (
              sortedJobs.map((job) => {
                const { data } = job;
                const { title, startDate, endDate, company, description } =
                  data;

                return (
                  <JobContent
                    title={title}
                    date={
                      formatShortDate(startDate) +
                      " — " +
                      (endDate ? formatShortDate(endDate) : "Actualidad")
                    }
                    company={company}
                    description={description}
                  />
                );
              })
            ) : (
              <p class="text-slate-400 col-span-full text-center">
                No se encontraron trabajos para mostrar.
              </p>
            )
          }
        </div>
      </div>
    </Card>

    <div class="col-span-12 lg:col-span-4 flex flex-col gap-6">
      <StudyContent
        icon="microscope"
        title="Titulación en Ingeniería de Software"
        institution="Universidad Tecnológica del Perú"
        description="Sistema web con modelo predictivo para la gestión de ventas de la empresa Industrias del Tecnoport y Empaques S.A.C Lima 2025 "
        status="En curso"
        date="Ago 2025 - Actualidad"
      />
      <StudyContent
        icon="education"
        title="Bachiller Ingeniería de Software"
        institution="Universidad Tecnológica del Perú"
        description="Carrera de pregrado de Ingeniería de Software"
        status="Graduado"
        date="Mar 2020 - Dic 2024"
      />
    </div>
    <div class="col-span-12">
      <div class="flex items-center gap-3 mb-6 mt-6">
        <Icon icon="seal-check" />
        <h3 class="text-xl font-bold">
          Certificaciones &amp; Formación Especializada
        </h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          sortedCertifications.length > 0 ? (
            sortedCertifications.map((certification) => {
              const { data } = certification;
              const { title, tech, date, institution } = data;

              return (
                <Certification
                  title={title}
                  tech={tech}
                  date={formatShortDate(date)}
                  institution={institution}
                />
              );
            })
          ) : (
            <p class="text-slate-400 col-span-full text-center">
              No se encontraron certificados para mostrar.
            </p>
          )
        }
      </div>
    </div>
  </div>
  <div class="mt-24 border-t border-white/5 pt-12 text-center">
    <p class="text-sm font-bold text-primary tracking-widest uppercase mb-8">
      Competencias Técnicas
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      {
        skills.map((skill) => {
          const { data } = skill;
          const { name } = data;

          return <Technical name={name} />;
        })
      }
    </div>
  </div>
</Layout>
