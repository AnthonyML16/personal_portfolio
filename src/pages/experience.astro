---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Experience | Anthony's Portfolio">
  <div class="mb-12">
    <div
      class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-400/10 border border-cyan-400/20 mb-4"
    >
      <span class="size-2 rounded-full bg-cyan-400 animate-pulse"></span>
      <span class="text-xs font-bold text-cyan-400 tracking-widest uppercase"
        >Career Path</span
      >
    </div>
    <h2 class="text-5xl md:text-6xl font-black tracking-tight mb-4">
      Journey &amp; Growth
    </h2>
    <p
      class="text-slate-500 dark:text-slate-400 text-lg max-w-2xl leading-relaxed"
    >
      A chronicle of my professional evolution, academic foundations, and
      continuous pursuit of technical excellence.
    </p>
  </div>
  <div class="grid grid-cols-12 gap-6">
    <div
      class="col-span-12 lg:col-span-8 glass-panel rounded-2xl p-8 cyan-glow"
    >
      <div class="flex items-center gap-3 mb-10">
        <span class="material-symbols-outlined text-cyan-400">work</span>
        <h3 class="text-2xl font-bold">Work Experience</h3>
      </div>
      <div class="relative">
        <div class="absolute left-1.5 top-2 bottom-2 w-0.5 timeline-line"></div>
        <div class="space-y-12">
          <div class="relative pl-10">
            <div
              class="absolute left-0 top-1.5 size-3 rounded-full bg-cyan-400 shadow-[0_0_10px_rgba(13,242,242,0.8)]"
            >
            </div>
            <div
              class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-2"
            >
              <h4 class="text-xl font-bold text-white">
                Senior Software Engineer
              </h4>
              <span
                class="text-xs font-bold px-3 py-1 rounded-full bg-white/5 border border-white/10 text-slate-400"
                >Jan 2022 — Present</span
              >
            </div>
            <p class="text-cyan-400 font-medium text-sm mb-4">
              Tech Innovations Corp
            </p>
            <ul class="space-y-3 text-slate-400 text-sm leading-relaxed">
              <li class="flex gap-2">
                <span class="text-cyan-400">•</span>
                Led the development of a microservices-based analytics platform serving
                50k+ active users.
              </li>
              <li class="flex gap-2">
                <span class="text-cyan-400">•</span>
                Reduced infrastructure costs by 30% through containerization and AWS
                optimization.
              </li>
              <li class="flex gap-2">
                <span class="text-cyan-400">•</span>
                Mentored junior developers and implemented CI/CD best practices.
              </li>
            </ul>
          </div>
          <div class="relative pl-10">
            <div
              class="absolute left-0 top-1.5 size-3 rounded-full bg-cyan-400/40 border border-cyan-400"
            >
            </div>
            <div
              class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-2"
            >
              <h4 class="text-xl font-bold text-white">Full Stack Developer</h4>
              <span
                class="text-xs font-bold px-3 py-1 rounded-full bg-white/5 border border-white/10 text-slate-400"
                >Mar 2019 — Dec 2021</span
              >
            </div>
            <p class="text-cyan-400 font-medium text-sm mb-4">
              Digital Pulse Agency
            </p>
            <ul class="space-y-3 text-slate-400 text-sm leading-relaxed">
              <li class="flex gap-2">
                <span class="text-cyan-400">•</span>
                Built and maintained 15+ React-based web applications for enterprise
                clients.
              </li>
              <li class="flex gap-2">
                <span class="text-cyan-400">•</span>
                Developed custom CMS solutions integrated with Headless WordPress.
              </li>
            </ul>
          </div>
          <div class="relative pl-10">
            <div
              class="absolute left-0 top-1.5 size-3 rounded-full bg-cyan-400/20 border border-cyan-400/50"
            >
            </div>
            <div
              class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-2"
            >
              <h4 class="text-xl font-bold text-white">Junior Web Developer</h4>
              <span
                class="text-xs font-bold px-3 py-1 rounded-full bg-white/5 border border-white/10 text-slate-400"
                >June 2017 — Feb 2019</span
              >
            </div>
            <p class="text-cyan-400 font-medium text-sm mb-4">StartUp Labs</p>
            <p class="text-slate-400 text-sm leading-relaxed">
              Responsible for frontend development using Vue.js and styling with
              SASS. Collaborated with designers to translate UI/UX wireframes
              into responsive web pages.
            </p>
          </div>
        </div>
      </div>
    </div>
    <div class="col-span-12 lg:col-span-4 flex flex-col gap-6">
      <div
        class="glass-panel rounded-2xl p-6 cyan-glow flex flex-col justify-between h-full group"
      >
        <div>
          <div
            class="size-10 bg-cyan-400/10 rounded-lg flex items-center justify-center border border-cyan-400/20 mb-4 group-hover:bg-cyan-400/20 transition-colors"
          >
            <span class="material-symbols-outlined text-cyan-400">school</span>
          </div>
          <h4 class="text-lg font-bold text-white mb-1">
            M.S. Computer Science
          </h4>
          <p class="text-slate-400 text-sm">Stanford University</p>
        </div>
        <div
          class="mt-8 pt-4 border-t border-white/5 flex justify-between items-center"
        >
          <span
            class="text-[10px] font-bold text-cyan-400 uppercase tracking-widest"
            >Graduated 2017</span
          >
          <span class="text-xs text-slate-500 italic">Major in AI</span>
        </div>
      </div>
      <div
        class="glass-panel rounded-2xl p-6 cyan-glow flex flex-col justify-between h-full group"
      >
        <div>
          <div
            class="size-10 bg-cyan-400/10 rounded-lg flex items-center justify-center border border-cyan-400/20 mb-4 group-hover:bg-cyan-400/20 transition-colors"
          >
            <span class="material-symbols-outlined text-cyan-400"
              >history_edu</span
            >
          </div>
          <h4 class="text-lg font-bold text-white mb-1">
            B.S. Software Engineering
          </h4>
          <p class="text-slate-400 text-sm">Georgia Institute of Technology</p>
        </div>
        <div
          class="mt-8 pt-4 border-t border-white/5 flex justify-between items-center"
        >
          <span
            class="text-[10px] font-bold text-cyan-400 uppercase tracking-widest"
            >Graduated 2015</span
          >
          <span class="text-xs text-slate-500 italic">Magna Cum Laude</span>
        </div>
      </div>
    </div>
    <div class="col-span-12">
      <div class="flex items-center gap-3 mb-6 mt-6">
        <span class="material-symbols-outlined text-cyan-400">verified</span>
        <h3 class="text-xl font-bold">
          Certifications &amp; Specialized Training
        </h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="glass-panel rounded-xl p-5 cyan-glow">
          <span
            class="text-[10px] font-bold text-cyan-400 uppercase tracking-widest block mb-2"
            >AWS</span
          >
          <h5 class="font-bold text-white text-sm mb-1">
            Solutions Architect Associate
          </h5>
          <p class="text-slate-500 text-xs">Credential ID: 893-X21</p>
        </div>
        <div class="glass-panel rounded-xl p-5 cyan-glow">
          <span
            class="text-[10px] font-bold text-cyan-400 uppercase tracking-widest block mb-2"
            >Google Cloud</span
          >
          <h5 class="font-bold text-white text-sm mb-1">
            Professional Data Engineer
          </h5>
          <p class="text-slate-500 text-xs">Credential ID: GCP-4402</p>
        </div>
        <div class="glass-panel rounded-xl p-5 cyan-glow">
          <span
            class="text-[10px] font-bold text-cyan-400 uppercase tracking-widest block mb-2"
            >Meta</span
          >
          <h5 class="font-bold text-white text-sm mb-1">
            Advanced React Development
          </h5>
          <p class="text-slate-500 text-xs">Issued Dec 2023</p>
        </div>
        <div class="glass-panel rounded-xl p-5 cyan-glow">
          <span
            class="text-[10px] font-bold text-cyan-400 uppercase tracking-widest block mb-2"
            >MongoDB</span
          >
          <h5 class="font-bold text-white text-sm mb-1">
            Associate Developer Node.js
          </h5>
          <p class="text-slate-500 text-xs">Issued June 2022</p>
        </div>
      </div>
    </div>
  </div>
  <div class="mt-24 border-t border-white/5 pt-12 text-center">
    <p class="text-sm font-bold text-cyan-400 tracking-widest uppercase mb-8">
      Technical Proficiency
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <div
        class="glass-panel px-5 py-2 rounded-full text-sm font-medium hover:text-cyan-400 transition-colors cursor-default"
      >
        TypeScript
      </div>
      <div
        class="glass-panel px-5 py-2 rounded-full text-sm font-medium hover:text-cyan-400 transition-colors cursor-default"
      >
        Next.js
      </div>
      <div
        class="glass-panel px-5 py-2 rounded-full text-sm font-medium hover:text-cyan-400 transition-colors cursor-default"
      >
        Tailwind CSS
      </div>
      <div
        class="glass-panel px-5 py-2 rounded-full text-sm font-medium hover:text-cyan-400 transition-colors cursor-default"
      >
        Node.js
      </div>
      <div
        class="glass-panel px-5 py-2 rounded-full text-sm font-medium hover:text-cyan-400 transition-colors cursor-default"
      >
        Python
      </div>
      <div
        class="glass-panel px-5 py-2 rounded-full text-sm font-medium hover:text-cyan-400 transition-colors cursor-default"
      >
        Rust
      </div>
      <div
        class="glass-panel px-5 py-2 rounded-full text-sm font-medium hover:text-cyan-400 transition-colors cursor-default"
      >
        Docker
      </div>
      <div
        class="glass-panel px-5 py-2 rounded-full text-sm font-medium hover:text-cyan-400 transition-colors cursor-default"
      >
        Kubernetes
      </div>
      <div
        class="glass-panel px-5 py-2 rounded-full text-sm font-medium hover:text-cyan-400 transition-colors cursor-default"
      >
        PostgreSQL
      </div>
    </div>
  </div>
</Layout>
