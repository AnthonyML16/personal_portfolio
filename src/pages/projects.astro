---
import Layout from "../layouts/Layout.astro";
import TitlePage from "../components/title/page.astro";
import Card from "../components/card/project.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");

const sortProject = projects.sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

export const prerender = true;

const gridConfigs = [
  {
    span: "col-span-12 lg:col-span-8 row-span-2",
    back: true,
    isFeatured: true,
  },
  {
    span: "col-span-12 md:col-span-6 lg:col-span-4 row-span-1",
    back: true,
    isFeatured: false,
  },
  {
    span: "col-span-12 md:col-span-6 lg:col-span-4 row-span-1",
    back: true,
    isFeatured: false,
  },
  {
    span: "col-span-12 md:col-span-6 lg:col-span-4 row-span-2",
    back: true,
    isFeatured: false,
  },
  {
    span: "col-span-12 lg:col-span-8 row-span-1",
    back: false,
    isFeatured: false,
  },
  {
    span: "col-span-12 md:col-span-6 lg:col-span-4 row-span-1",
    back: true,
    isFeatured: false,
  },
  {
    span: "col-span-12 md:col-span-6 lg:col-span-4 row-span-1",
    back: true,
    isFeatured: false,
  },
];
---

<Layout
  title="Proyectos | Portfolio de Anthony"
  description="Muestra de trabajos y proyectos realizados"
>
  <TitlePage
    pulse="Desarrollos"
    title="Proyectos"
    colorTitle="Realizados"
    description="Una selección de sistemas empresariales y plataformas digitales diseñadas para resolver problemas complejos."
  />

  <div class="grid grid-cols-12 gap-6 auto-rows-[240px]">
    {
      sortProject.map((project, index) => {
        const config = gridConfigs[index % gridConfigs.length];

        return (
          <Card
            class={`${config.span}`}
            title={project.data.title}
            img={project.data.img}
            stack={project.data.stack as string[]}
            description={project.data.description}
            site={project.data.site as string | null}
            repo={project.data.repo as string | null}
            isFeatured={config.isFeatured}
            back={config.back}
          />
        );
      })
    }
  </div>
</Layout>
