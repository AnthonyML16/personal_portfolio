---
import Layout from "../layouts/Layout.astro";

const skillCategories = [
  {
    title: "Frontend",
    skills: [
      "React",
      "Astro",
      "TypeScript",
      "Tailwind CSS",
      "Next.js",
      "Vue.js",
    ],
  },
  {
    title: "Backend",
    skills: ["Node.js", "Python", "PostgreSQL", "GraphQL", "Redis", "Docker"],
  },
  {
    title: "Tools & Others",
    skills: ["Git", "Figma", "AWS", "CI/CD", "Jest", "Agile"],
  },
];
---

<Layout title="Skills | Anthony's Portfolio">
  <div class="mb-12">
    <div
      class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-400/10 border border-cyan-400/20 mb-4"
    >
      <span class="size-2 rounded-full bg-cyan-400 animate-pulse"></span>
      <span class="text-xs font-bold text-cyan-400 tracking-widest uppercase"
        >Expertise</span
      >
    </div>
    <h2 class="text-5xl md:text-6xl font-black tracking-tight mb-4">
      Skills &amp; <span class="text-cyan-400">Capabilities</span>
    </h2>
    <p
      class="text-slate-500 dark:text-slate-400 text-lg max-w-2xl leading-relaxed"
    >
      A technical deep-dive into my stack. I specialize in building
      high-performance applications with a focus on modern web standards and
      architectural excellence.
    </p>
  </div>
  <div class="grid grid-cols-12 gap-6 auto-rows-[minmax(200px,auto)]">
    <div
      class="col-span-12 lg:col-span-8 bento-card-skills flex flex-col justify-between"
    >
      <div>
        <div class="flex items-center gap-3 mb-6">
          <span class="material-symbols-outlined text-cyan-400">layers</span>
          <h3 class="text-2xl font-bold">Core Technologies</h3>
        </div>
        <div class="grid md:grid-cols-2 gap-x-12 gap-y-6">
          <div class="space-y-4">
            <div>
              <div class="flex justify-between text-sm mb-2">
                <span class="font-bold">Next.js &amp; React</span>
                <span class="text-cyan-400">95%</span>
              </div>
              <div
                class="h-2 bg-white/5 rounded-full overflow-hidden border border-white/10"
              >
                <div class="h-full bg-cyan-400 w-[95%]"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-sm mb-2">
                <span class="font-bold">TypeScript</span>
                <span class="text-cyan-400">90%</span>
              </div>
              <div
                class="h-2 bg-white/5 rounded-full overflow-hidden border border-white/10"
              >
                <div
                  class="h-full bg-cyan-400 w-[90%] shadow-[0_0_10px_rgba(13,242,242,0.4)]"
                >
                </div>
              </div>
            </div>
          </div>
          <div class="space-y-4">
            <div>
              <div class="flex justify-between text-sm mb-2">
                <span class="font-bold">Tailwind CSS</span>
                <span class="text-cyan-400">98%</span>
              </div>
              <div
                class="h-2 bg-white/5 rounded-full overflow-hidden border border-white/10"
              >
                <div
                  class="h-full bg-cyan-400 w-[98%] shadow-[0_0_10px_rgba(13,242,242,0.4)]"
                >
                </div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-sm mb-2">
                <span class="font-bold">Node.js</span>
                <span class="text-cyan-400">85%</span>
              </div>
              <div
                class="h-2 bg-white/5 rounded-full overflow-hidden border border-white/10"
              >
                <div
                  class="h-full bg-cyan-400 w-[85%] shadow-[0_0_10px_rgba(13,242,242,0.4)]"
                >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <p class="text-sm text-slate-500 mt-8">
        Extensive experience in production-grade full-stack development since
        2019.
      </p>
    </div>
    <div
      class="col-span-12 md:col-span-4 bento-card-skills flex flex-col justify-between bg-cyan-400/5 border-cyan-400/20"
    >
      <div class="flex items-center justify-between mb-4">
        <span
          class="text-[10px] font-black text-cyan-400 uppercase tracking-widest px-2 py-1 bg-cyan-400/10 rounded"
          >On the Radar</span
        >
        <span class="material-symbols-outlined text-cyan-400">auto_awesome</span
        >
      </div>
      <div>
        <h4 class="text-xl font-bold mb-2">Learning Now</h4>
        <p class="text-slate-400 text-sm mb-4">
          Diving deep into AI integration and Vector Databases for intelligent
          agents.
        </p>
        <div class="flex items-center gap-2 text-cyan-400 font-bold">
          <span class="text-sm uppercase tracking-tighter"
            >LangChain + Pinecone</span
          >
        </div>
      </div>
    </div>
    <div class="col-span-12 md:col-span-6 lg:col-span-4 bento-card-skills">
      <div class="flex items-center gap-3 mb-6">
        <span class="material-symbols-outlined text-cyan-400">database</span>
        <h3 class="text-xl font-bold">Backend Tools</h3>
      </div>
      <div class="flex flex-wrap gap-2">
        <span
          class="px-3 py-1.5 bg-white/5 border border-white/10 rounded text-xs font-medium text-slate-300"
          >PostgreSQL</span
        >
        <span
          class="px-3 py-1.5 bg-white/5 border border-white/10 rounded text-xs font-medium text-slate-300"
          >GraphQL</span
        >
        <span
          class="px-3 py-1.5 bg-white/5 border border-white/10 rounded text-xs font-medium text-slate-300"
          >Prisma</span
        >
        <span
          class="px-3 py-1.5 bg-white/5 border border-white/10 rounded text-xs font-medium text-slate-300"
          >Docker</span
        >
        <span
          class="px-3 py-1.5 bg-white/5 border border-white/10 rounded text-xs font-medium text-slate-300"
          >Redis</span
        >
        <span
          class="px-3 py-1.5 bg-white/5 border border-white/10 rounded text-xs font-medium text-slate-300"
          >AWS S3</span
        >
        <span
          class="px-3 py-1.5 bg-white/5 border border-white/10 rounded text-xs font-medium text-slate-300"
          >Express</span
        >
        <span
          class="px-3 py-1.5 bg-white/5 border border-white/10 rounded text-xs font-medium text-slate-300"
          >tRPC</span
        >
      </div>
    </div>
    <div class="col-span-12 md:col-span-6 lg:col-span-4 bento-card-skills">
      <div class="flex items-center gap-3 mb-6">
        <span class="material-symbols-outlined text-cyan-400">palette</span>
        <h3 class="text-xl font-bold">Design &amp; UX</h3>
      </div>
      <div class="space-y-4">
        <div class="flex items-center justify-between group">
          <span
            class="text-sm text-slate-400 group-hover:text-white transition-colors"
            >Figma Design System</span
          >
          <span class="material-symbols-outlined text-cyan-400 text-sm"
            >check_circle</span
          >
        </div>
        <div class="flex items-center justify-between group">
          <span
            class="text-sm text-slate-400 group-hover:text-white transition-colors"
            >Framer Motion</span
          >
          <span class="material-symbols-outlined text-cyan-400 text-sm"
            >check_circle</span
          >
        </div>
        <div class="flex items-center justify-between group">
          <span
            class="text-sm text-slate-400 group-hover:text-white transition-colors"
            >Responsive Prototyping</span
          >
          <span class="material-symbols-outlined text-cyan-400 text-sm"
            >check_circle</span
          >
        </div>
        <div class="flex items-center justify-between group">
          <span
            class="text-sm text-slate-400 group-hover:text-white transition-colors"
            >Accessibility (A11y)</span
          >
          <span class="material-symbols-outlined text-cyan-400 text-sm"
            >check_circle</span
          >
        </div>
      </div>
    </div>
    <div
      class="col-span-12 md:col-span-12 lg:col-span-4 bento-card-skills flex flex-col justify-between"
    >
      <div>
        <div class="flex items-center gap-3 mb-6">
          <span class="material-symbols-outlined text-cyan-400">groups</span>
          <h3 class="text-xl font-bold">Soft Skills</h3>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-3 bg-white/5 rounded border border-white/5">
            <h5 class="text-cyan-400 text-[10px] font-black uppercase mb-1">
              Leadership
            </h5>
            <p class="text-xs text-slate-400">Team Mentoring</p>
          </div>
          <div class="p-3 bg-white/5 rounded border border-white/5">
            <h5 class="text-cyan-400 text-[10px] font-black uppercase mb-1">
              Workflow
            </h5>
            <p class="text-xs text-slate-400">Agile &amp; Scrum</p>
          </div>
          <div class="p-3 bg-white/5 rounded border border-white/5">
            <h5 class="text-cyan-400 text-[10px] font-black uppercase mb-1">
              Mindset
            </h5>
            <p class="text-xs text-slate-400">Problem Solver</p>
          </div>
          <div class="p-3 bg-white/5 rounded border border-white/5">
            <h5 class="text-cyan-400 text-[10px] font-black uppercase mb-1">
              Communication
            </h5>
            <p class="text-xs text-slate-400">Remote Expert</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="mt-20 text-center">
    <p class="text-sm font-bold text-cyan-400 tracking-widest uppercase mb-8">
      Trusted by Modern Teams
    </p>
    <div class="flex flex-wrap justify-center gap-12 opacity-40 grayscale">
      <div class="flex items-center gap-2 font-black text-2xl tracking-tighter">
        PROJECT_ALPHA
      </div>
      <div class="flex items-center gap-2 font-black text-2xl tracking-tighter">
        NEXUS_CORE
      </div>
      <div class="flex items-center gap-2 font-black text-2xl tracking-tighter">
        FLOW_SYSTEMS
      </div>
      <div class="flex items-center gap-2 font-black text-2xl tracking-tighter">
        ZENITH_LABS
      </div>
    </div>
  </div>
