---
import Layout from "../layouts/Layout.astro";
import TitlePage from "../components/title/page.astro";
import Card from "../components/card/main.astro";
import TitleCard from "../components/title/card.astro";
import SkillPercentaje from "../components/block/skill-percentaje.astro";
import TagMain from "../components/tag/main.astro";
import Icon from "../components/icon.astro";
import Technical from "../components/card/technical-second.astro";
import LabelCheck from "../components/block/label-check.astro";
import { getCollection } from "astro:content";

const skills = await getCollection("skills");

const core = skills.filter((skill) => skill.data.category === "core");
const backend = skills.filter((skill) => skill.data.category === "backend");
const design = skills.filter((skill) => skill.data.category === "design");
const tools = skills.filter((skill) => skill.data.category === "tool");

export const prerender = true;
---

<Layout title="Skills | Anthony's Portfolio">
  <TitlePage
    pulse="Conocimientos"
    title="Habilidades &"
    colorTitle="Capacidades"
    description="Un análisis de mis capacidades técnicas actuales, desde la planificación hasta la implementación completa, siempre en constante aprendizaje."
  />

  <div class="grid grid-cols-12 gap-6 auto-rows-[minmax(200px,auto)]">
    <Card class="col-span-12 lg:col-span-8">
      <TitleCard icon="layers" title="Tecnologías principales" />
      <div class="grid md:grid-cols-2 gap-x-12 gap-y-6">
        {
          core.map((skill) => {
            const { data } = skill;
            const { name, percentage } = data;

            return (
              <SkillPercentaje
                skill={name}
                percentage={percentage ? percentage : 0}
              />
            );
          })
        }
      </div>
      <p class="text-sm text-slate-500 mt-8">
        Amplia experiencia en desarrollo full-stack.
      </p>
    </Card>

    <Card class="col-span-12 md:col-span-4 flex flex-col justify-between">
      <div class="flex items-center justify-between mb-4">
        <TagMain label="En el radar" />
        <Icon icon="sparkles-alt" />
      </div>
      <div>
        <h4 class="text-xl font-bold mb-2">Aprendizaje ahora</h4>
        <p class="text-slate-400 text-sm mb-4">
          Profundizando en la integración y desarrollo de IA.
        </p>
        <div class="flex items-center gap-2 text-primary font-bold">
          <span class="text-sm uppercase tracking-tighter">
            Python + Gemini + GPT
          </span>
        </div>
      </div>
    </Card>

    <Card class="col-span-12 md:col-span-6 lg:col-span-4">
      <TitleCard icon="database" title="Backend" />
      <div class="flex flex-wrap gap-2">
        {
          backend.map((skill) => {
            const { data } = skill;
            const { name } = data;

            return <Technical name={name} />;
          })
        }
      </div>
    </Card>

    <Card class="col-span-12 md:col-span-6 lg:col-span-4">
      <TitleCard icon="palette" title="Diseño" />
      <div class="space-y-4">
        {
          design.map((skill) => {
            const { data } = skill;
            const { name } = data;

            return <LabelCheck name={name} />;
          })
        }
      </div>
    </Card>

    <Card class="col-span-12 md:col-span-12 lg:col-span-4">
      <TitleCard icon="code-alt" title="Otros" />
      <div class="flex flex-wrap gap-2">
        {
          tools.map((skill) => {
            const { data } = skill;
            const { name } = data;

            return <Technical name={name} />;
          })
        }
      </div>
    </Card>
  </div>
</Layout>
